{
  "name": "dsh-ast-grep",
  "version": "0.1.0",
  "description": "Persistent ast-grep structural search tools for DeepSeek Harness",
  "license": "MIT",
  "author": "lujunjiehhh",
  "homepage": "https://github.com/lujunjiehhh/dsh-ast-grep#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lujunjiehhh/dsh-ast-grep.git"
