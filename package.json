  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "ast-grep",
    "structural-search",
    "cordis"
  ],
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node test.mjs",
    "check": "node --check src/index.js && node test.mjs",
    "prepack": "pnpm check"
  },
